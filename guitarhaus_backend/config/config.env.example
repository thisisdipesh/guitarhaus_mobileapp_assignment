NODE_ENV=development
PORT=3003

# Database - Connect to existing guitarhaus_db database
LOCAL_DATABASE_URI=mongodb://127.0.0.1:27017/guitarhaus_db

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# Stripe Configuration (Get these from your Stripe dashboard)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# File Upload
MAX_FILE_SIZE=10000000

# CORS - Allow mobile app and web app connections
CORS_ORIGIN=http://localhost:3000,http://localhost:5000,*

# Email (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password 